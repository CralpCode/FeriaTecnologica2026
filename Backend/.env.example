# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (FASTAPI)
# ==============================================================================
HOST=0.0.0.0
PORT=8000

# Orígenes CORS permitidos (separados por coma, o * para permitir todos)
CORS_ORIGINS=*

# LLM local compatible con la API de OpenAI.
#   Ollama nativo (por defecto): http://localhost:11434/v1
#   Splash (opcional, macOS 26.4+): la URL que muestre `splash serve`
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:32b
LLM_TIMEOUT_S=90

# Modelo de audio cardíaco (TorchScript entrenado en IA/)
HEART_MODEL_PATH=models/heart_cnn.pt
