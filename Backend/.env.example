# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (FASTAPI)
# ==============================================================================
HOST=0.0.0.0
PORT=8000

# Orígenes CORS permitidos (separados por coma, o * para permitir todos)
CORS_ORIGINS=*

# Ruta del archivo de Base de Datos SQLite
DATABASE_PATH=vitals.db

# (Opcional) API Key de Inteligencia Artificial
AI_PROVIDER=rule_engine
# GEMINI_API_KEY=tu_api_key_aqui
