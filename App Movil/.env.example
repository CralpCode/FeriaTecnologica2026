# ==============================================================================
# CONFIGURACIÓN DE LA APP MÓVIL / WEB VITALSYNC
# ==============================================================================

# OPCIÓN 1: Desarrollo Local (IP de tu PC en la red Wi-Fi local)
EXPO_PUBLIC_API_URL=http://192.168.1.163:8000/api

# OPCIÓN 2: Producción en la Nube (Descomenta y pega tu URL de Render / Railway / Fly.io)
# EXPO_PUBLIC_API_URL=https://vitalsync-api.onrender.com/api

# Modo de datos (false = Backend real / true = Datos simulados)
EXPO_PUBLIC_USE_MOCK=false
